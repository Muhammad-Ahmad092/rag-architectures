# ---------------------------------------------------------------------------
# advanced-rag configuration. Copy to .env and fill in what you need.
# The defaults need ONLY ANTHROPIC_API_KEY (local embeddings + local Chroma);
# add COHERE_API_KEY for the Cohere reranker (otherwise a local cross-encoder is used).
# ---------------------------------------------------------------------------

# --- LLM (this folder uses Anthropic Claude; also the eval judge) ----------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (thinking is always on; effort sets its depth)
LLM_EFFORT=medium
# Query rewriter + answer checker. Empty = LLM_MODEL (e.g. claude-haiku-5-5 to save cost)
GRADER_MODEL=
GRADER_EFFORT=low

# --- Advanced pipeline -----------------------------------------------------------------
# Search queries per question, including the original (1 = no rewriting)
NUM_QUERIES=3
# Hits per retriever (vector, BM25) per query, before fusion
CANDIDATE_K=8
# Reciprocal rank fusion constant (60 is the standard value)
RRF_K=60
# cohere | local | none   (cohere without COHERE_API_KEY falls back to local)
RERANKER=cohere
RERANK_MODEL=rerank-v3.5
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Verify the answer is supported; revise once if not
CHECK_ANSWER=true

# OPENAI_API_KEY: openai embeddings, and the common generator in fair-mode eval
OPENAI_API_KEY=

# --- Embeddings ----------------------------------------------------------------
# openai | gemini | cohere | voyage | huggingface (local, free)
# Non-default providers need an extra, e.g. `uv sync --extra cohere`
EMBEDDING_PROVIDER=huggingface
# Leave empty to use the provider default:
#   openai=text-embedding-3-small  gemini=gemini-embedding-001 (768-d)
#   cohere=embed-english-v3.0      voyage=voyage-3.5-lite
#   huggingface=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=
GEMINI_API_KEY=
# (also used by the Cohere reranker)
COHERE_API_KEY=
VOYAGE_API_KEY=

# --- Vector store ----------------------------------------------------------------
# local: chroma | faiss | qdrant-local | lancedb
# cloud: pinecone | qdrant-cloud | weaviate-cloud
# Non-default stores need an extra, e.g. `uv sync --extra faiss` (or --extra all)
VECTOR_STORE=chroma
INDEX_DIR=.index

PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

QDRANT_URL=
QDRANT_API_KEY=

WEAVIATE_URL=
WEAVIATE_API_KEY=

# --- Data, chunking & retrieval ------------------------------------------------------
DATA_DIR=../sample_data
EVAL_QUESTIONS=../sample_data/eval/questions.jsonl
TOP_K=4
# SentenceSplitter, in tokens
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- Evaluation (eval/run_eval.py, fair mode) -------------------------------------
# Fair mode uses the same generator for every RAG type (OpenAI) + a separate judge
EVAL_LLM=gpt-4o-mini
EVAL_JUDGE_MODEL=claude-sonnet-5-5
