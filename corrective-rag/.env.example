# ---------------------------------------------------------------------------
# corrective-rag configuration. Copy to .env and fill in what you need.
# The defaults need ONLY OPENAI_API_KEY (local embeddings + local Chroma).
# Add TAVILY_API_KEY to enable the web-search fallback.
# ---------------------------------------------------------------------------

# --- LLM (this folder uses OpenAI; also the retrieval evaluator) ------------------
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- CRAG retrieval evaluator --------------------------------------------------------
# Per-passage score 0..1.  Any passage >= UPPER -> CORRECT;  all < LOWER -> INCORRECT;
# otherwise AMBIGUOUS (refined passages + web results)
UPPER_THRESHOLD=0.7
LOWER_THRESHOLD=0.3
# Keep only the question-relevant sentences of each kept passage (1 LLM call per passage)
REFINE_KNOWLEDGE=true

# --- Web search fallback (Tavily, https://tavily.com) ----------------------------------
TAVILY_API_KEY=
WEB_SEARCH=true
WEB_RESULTS=3

# --- Embeddings ----------------------------------------------------------------
# openai | gemini | cohere | voyage | huggingface (local, free)
# Non-default providers need an extra, e.g. `uv sync --extra cohere`
EMBEDDING_PROVIDER=huggingface
# Leave empty to use the provider default:
#   openai=text-embedding-3-small  gemini=gemini-embedding-001 (768-d)
#   cohere=embed-english-v3.0      voyage=voyage-3.5-lite
#   huggingface=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=
# (openai embeddings reuse OPENAI_API_KEY above)
GEMINI_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# --- Vector store ----------------------------------------------------------------
# local: chroma | faiss | qdrant-local | lancedb
# cloud: pinecone | qdrant-cloud | weaviate-cloud
# Non-default stores need an extra, e.g. `uv sync --extra faiss` (or --extra all)
VECTOR_STORE=chroma
INDEX_DIR=.index

PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

QDRANT_URL=
QDRANT_API_KEY=

WEAVIATE_URL=
WEAVIATE_API_KEY=

# --- Data, chunking & retrieval ------------------------------------------------------
DATA_DIR=../sample_data
EVAL_QUESTIONS=../sample_data/eval/questions.jsonl
TOP_K=4
# RecursiveCharacterTextSplitter, in characters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Evaluation (eval/run_eval.py, fair mode) -------------------------------------
# Fair mode uses the same generator for every RAG type (OpenAI) + a separate judge
EVAL_LLM=gpt-4o-mini
ANTHROPIC_API_KEY=
EVAL_JUDGE_MODEL=claude-sonnet-5-5
