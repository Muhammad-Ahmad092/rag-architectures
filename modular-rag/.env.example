# ---------------------------------------------------------------------------
# modular-rag configuration. Copy to .env and fill in what you need.
# The defaults need ONLY MISTRAL_API_KEY (local embeddings + local Chroma).
# ---------------------------------------------------------------------------

# --- Generator modules -----------------------------------------------------------
MISTRAL_API_KEY=
LLM_MODEL=mistral-small-latest
# The "openai" generator module (also the fair-mode eval generator)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Default modules (each can be swapped per question in the UI) -------------------
# vector | bm25 | hybrid  (bm25/hybrid read INDEX_DIR/corpus.jsonl, written by ingest)
RETRIEVER=hybrid
# none | cross-encoder | lost-in-the-middle  (cross-encoder downloads a ~90 MB model once)
RANKER=none
# mistral | openai
GENERATOR=mistral
# Retrieved before ranking -> TOP_K kept after ranking
CANDIDATE_K=8
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Embeddings ----------------------------------------------------------------
# openai | gemini | cohere | voyage | huggingface (local, free)
EMBEDDING_PROVIDER=huggingface
# Leave empty to use the provider default:
#   openai=text-embedding-3-small  gemini=gemini-embedding-001
#   cohere=embed-english-v3.0      voyage=voyage-3.5-lite
#   huggingface=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=
GEMINI_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# --- Vector store ----------------------------------------------------------------
# local: chroma | faiss | qdrant-local | lancedb
# cloud: pinecone | qdrant-cloud | weaviate-cloud
# Non-default stores need an extra, e.g. `uv sync --extra faiss` (or --extra all)
VECTOR_STORE=chroma
# Where local stores persist their data
INDEX_DIR=.index

PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

QDRANT_URL=
QDRANT_API_KEY=

WEAVIATE_URL=
WEAVIATE_API_KEY=

# --- Data & retrieval -------------------------------------------------------------
DATA_DIR=../sample_data
EVAL_QUESTIONS=../sample_data/eval/questions.jsonl
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Evaluation (eval/run_eval.py, fair mode) -------------------------------------
# Common generator for all RAG types, plus a separate judge to avoid self-grading
EVAL_LLM=gpt-4o-mini
ANTHROPIC_API_KEY=
EVAL_JUDGE_MODEL=claude-sonnet-5-5
