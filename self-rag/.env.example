# ---------------------------------------------------------------------------
# self-rag configuration. Copy to .env and fill in what you need.
# The defaults need ONLY ANTHROPIC_API_KEY (local embeddings + local Chroma).
# ---------------------------------------------------------------------------

# --- LLM (this folder uses Anthropic Claude) ---------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (thinking is always on; effort sets its depth)
LLM_EFFORT=medium
# Graders (relevance / support / usefulness). Empty = LLM_MODEL.
# A cheaper grader cuts cost a lot: there are top_k + 2 grader calls per pass, e.g. claude-haiku-5-5
GRADER_MODEL=
GRADER_EFFORT=low

# --- Self-RAG loop limits --------------------------------------------------------------
# Query rewrites when no retrieved passage is relevant (or the answer is not useful)
MAX_REWRITES=2
# Answer attempts per retrieval when the answer is not supported by the passages
MAX_GENERATIONS=2

# --- Embeddings ----------------------------------------------------------------
# openai | gemini | cohere | voyage | huggingface (local, free)
# Non-default providers need an extra, e.g. `uv sync --extra cohere`
EMBEDDING_PROVIDER=huggingface
# Leave empty to use the provider default:
#   openai=text-embedding-3-small  gemini=gemini-embedding-001 (768-d)
#   cohere=embed-english-v3.0      voyage=voyage-3.5-lite
#   huggingface=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=
# OPENAI_API_KEY: openai embeddings, and the common generator in fair-mode eval
OPENAI_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# --- Vector store ----------------------------------------------------------------
# local: chroma | faiss | qdrant-local | lancedb
# cloud: pinecone | qdrant-cloud | weaviate-cloud
# Non-default stores need an extra, e.g. `uv sync --extra faiss` (or --extra all)
VECTOR_STORE=chroma
INDEX_DIR=.index

PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

QDRANT_URL=
QDRANT_API_KEY=

WEAVIATE_URL=
WEAVIATE_API_KEY=

# --- Data, chunking & retrieval ------------------------------------------------------
DATA_DIR=../sample_data
EVAL_QUESTIONS=../sample_data/eval/questions.jsonl
TOP_K=4
# RecursiveCharacterTextSplitter, in characters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Evaluation (eval/run_eval.py, fair mode) -------------------------------------
# Fair mode uses the same generator for every RAG type (OpenAI) + a separate judge
EVAL_LLM=gpt-4o-mini
# (the judge reuses ANTHROPIC_API_KEY above)
EVAL_JUDGE_MODEL=claude-sonnet-5-5
